{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinetic-trust-protocol.net/specs/schemas/component-claim-v1/component-claim.json",
  "title": "Component-scoped implementer claim metadata",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "claim_version": {
      "const": "component-claim-v1"
    },
    "implementer": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "release": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "profile": {
      "enum": [
        "core-evaluation-v1",
        "trust-proof-verifier-v1",
        "oracle-issuer-v1",
        "evaluator-pdp-v1",
        "pep-enforcement-v1",
        "flight-recorder-v1",
        "transport-federation-v1"
      ]
    },
    "scope": {
      "const": "component"
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "build": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "uri",
        "build"
      ]
    },
    "declaration_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "proposed",
        "specified",
        "tested",
        "independently reproduced"
      ]
    },
    "suite_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "tag": {
            "type": "string",
            "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "tag",
          "digest"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "schema",
              "execution",
              "runtime",
              "independent"
            ]
          },
          "uri": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "implementation_build": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "declaration_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "kind",
          "uri",
          "digest",
          "implementation_build",
          "declaration_digest"
        ]
      }
    }
  },
  "required": [
    "claim_version",
    "implementer",
    "release",
    "profile",
    "scope",
    "implementation",
    "declaration_digest",
    "status",
    "suite_versions",
    "evidence"
  ]
}
