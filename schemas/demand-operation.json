{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinetic-trust-protocol.net/specs/schemas/v3/demand-operation.json",
  "title": "Complete preclassification operation binding (proposed demand supplier contract)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject",
    "actor",
    "audience",
    "operation",
    "resource",
    "parameters",
    "request_id",
    "replay_domain"
  ],
  "properties": {
    "subject": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "maxLength": 2048
    },
    "actor": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "maxLength": 2048
    },
    "audience": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "maxLength": 2048
    },
    "operation": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "maxLength": 2048
    },
    "resource": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "maxLength": 2048
    },
    "parameters": {
      "type": "object"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "replay_domain": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "maxLength": 2048
    }
  }
}
