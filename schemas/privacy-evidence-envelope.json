{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinetic-trust-protocol.net/specs/schemas/privacy-v1/privacy-evidence-envelope.json",
  "title": "KTP Privacy Evidence Envelope v1 — Unreleased",
  "description": "New signed storage envelope for exact encrypted evidence bytes. This is not a replacement trajectory, authorization token, erasure certificate, or proof of original content validity. Minimal headers may remain personal data. See specifications/privacy-evidence.md for AAD, signature/hash, anchors, retention and erasure limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "envelope_id",
    "zone_id",
    "chain_id",
    "sequence",
    "previous_hash",
    "conformance_level",
    "purpose_id",
    "privacy_policy_digest",
    "created_at",
    "delete_after",
    "issuer_id",
    "encryption",
    "signature",
    "record_hash"
  ],
  "properties": {
    "format": {
      "const": "ktp-privacy-evidence-v1"
    },
    "envelope_id": {
      "$ref": "#/$defs/literal"
    },
    "zone_id": {
      "$ref": "#/$defs/literal"
    },
    "chain_id": {
      "$ref": "#/$defs/literal"
    },
    "sequence": {
      "$ref": "#/$defs/positive_integer"
    },
    "previous_hash": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "conformance_level": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    },
    "purpose_id": {
      "$ref": "#/$defs/literal"
    },
    "privacy_policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "created_at": {
      "$ref": "#/$defs/integer"
    },
    "delete_after": {
      "$ref": "#/$defs/positive_integer"
    },
    "issuer_id": {
      "$ref": "#/$defs/literal"
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_ref",
        "nonce",
        "ciphertext"
      ],
      "properties": {
        "algorithm": {
          "const": "A256GCM"
        },
        "key_ref": {
          "$ref": "#/$defs/literal"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16}$",
          "minLength": 16,
          "maxLength": 16
        },
        "ciphertext": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 23
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "record_hash": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "literal": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s*?\\[\\]{}]+$(?![\\s\\S])",
      "description": "Exact nonempty identifier without whitespace or wildcard characters. Matching is literal; no wildcard or range compatibility is supported."
    },
    "digest": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "string",
          "minLength": 103,
          "maxLength": 103,
          "pattern": "^sha384:[0-9a-f]{96}$"
        }
      ],
      "description": "Algorithm-prefixed lowercase digest. Every binding in a Level 3 privacy evidence verification requires SHA-384; the trusted profile selects the requirement."
    },
    "integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
