{
  "type": "object",
  "required": [
    "artifact_type",
    "request_binding",
    "request_digest",
    "proof_digest",
    "evidence_digest",
    "prerequisite_digests",
    "consumption_epoch",
    "evaluated_at",
    "expires_at",
    "issuer_id",
    "result",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "const": "ktp-software-substrate-decision"
    },
    "request_binding": {
      "$ref": "#/$defs/request_binding"
    },
    "request_digest": {
      "$ref": "#/$defs/digest"
    },
    "proof_digest": {
      "$ref": "#/$defs/digest"
    },
    "evidence_digest": {
      "$ref": "#/$defs/digest"
    },
    "prerequisite_digests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "consumption_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "evaluated_at": {
      "$ref": "#/$defs/safe_integer"
    },
    "expires_at": {
      "$ref": "#/$defs/safe_integer"
    },
    "issuer_id": {
      "$ref": "#/$defs/literal"
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "signature": {
      "type": "string",
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$(?![\\s\\S])"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinetic-trust-protocol.net/specs/schemas/software-substrate-decision.json",
  "title": "Software-substrate consumption decision \u2014 proposal, unreleased",
  "description": "Separately signed consumption decision bound to an existing complete ordinary proof, actual software request, installed profile/policy, local evidence, prerequisite artifacts and current epoch. Not a Trust Proof extension or standalone permission. All members except signature are covered by the canonical signed payload. Schema shape does not verify signatures, numeric finiteness, digests, current state, expiry, observation authenticity or authority; the profile requires semantic checks.",
  "$defs": {
    "safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "literal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\s*?\\[\\]{}]+$(?![\\s\\S])"
    },
    "digest": {
      "type": "string",
      "pattern": "^(sha256:[0-9a-f]{64}|sha384:[0-9a-f]{96})$(?![\\s\\S])"
    },
    "request_binding": {
      "type": "object",
      "required": [
        "request_id",
        "actor_id",
        "workload_id",
        "authority_class",
        "operation_id",
        "resource_id",
        "enforcement_destination",
        "parameters_digest",
        "identity_session_digest",
        "execution_profile_digest",
        "policy_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/literal"
        },
        "actor_id": {
          "$ref": "#/$defs/literal"
        },
        "workload_id": {
          "$ref": "#/$defs/literal"
        },
        "authority_class": {
          "$ref": "#/$defs/literal"
        },
        "operation_id": {
          "$ref": "#/$defs/literal"
        },
        "resource_id": {
          "$ref": "#/$defs/literal"
        },
        "enforcement_destination": {
          "$ref": "#/$defs/literal"
        },
        "parameters_digest": {
          "$ref": "#/$defs/digest"
        },
        "identity_session_digest": {
          "$ref": "#/$defs/digest"
        },
        "execution_profile_digest": {
          "$ref": "#/$defs/digest"
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "ceiling": {
      "type": "object",
      "required": [
        "magnitude",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "magnitude": {
          "enum": [
            "effectBytes",
            "affectedObjects",
            "fanoutTargets"
          ]
        },
        "max": {
          "$ref": "#/$defs/safe_integer"
        }
      }
    },
    "constraints": {
      "type": "object",
      "required": [
        "profile",
        "ceilings"
      ],
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "software-substrate-execution"
        },
        "ceilings": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/ceiling"
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "magnitude"
                ],
                "properties": {
                  "magnitude": {
                    "const": "effectBytes"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "magnitude"
                ],
                "properties": {
                  "magnitude": {
                    "const": "affectedObjects"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "magnitude"
                ],
                "properties": {
                  "magnitude": {
                    "const": "fanoutTargets"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "autonomyDemand",
        "environmentalCapacity",
        "capacityKnown",
        "repairPathVerified",
        "supervisionAvailable",
        "tightenedConstraints",
        "supervision",
        "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "autonomyDemand": {
          "type": "number",
          "minimum": 0
        },
        "environmentalCapacity": {
          "type": "number",
          "minimum": 0
        },
        "capacityKnown": {
          "type": "boolean"
        },
        "repairPathVerified": {
          "type": "boolean"
        },
        "supervisionAvailable": {
          "type": "boolean"
        },
        "tightenedConstraints": {
          "$ref": "#/$defs/constraints"
        },
        "supervision": {
          "enum": [
            "stable",
            "metacognitive",
            "assisted",
            "regulated",
            "silent_veto"
          ]
        },
        "rationale": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "margin": {
          "type": "number"
        }
      }
    }
  }
}
