        "environmentSupervision": 1,
        "holds": [
          {
            "actor": "agent:a",
            "action_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
            "raisedBy": "normative",
            "supervision": 3
          },
          {
            "actor": "agent:b",
            "action_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
            "raisedBy": "normative",
            "supervision": 3
          },
          {
            "actor": "agent:a",
            "action_digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
            "raisedBy": "normative",
            "supervision": 3
          }
        ],
        "release": {
          "by": "normative",
          "signed": true,
          "actor": "agent:a",
          "action_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "to": 1
        }
      },
      "expect": {
        "supervisionAfter": [
          {
            "actor": "agent:a",
            "action_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
            "supervision": 1
          },
          {
            "actor": "agent:b",
            "action_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
            "supervision": 3
          },
          {
            "actor": "agent:a",
            "action_digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
            "supervision": 3
          }
        ]
      },
      "reason": "A release applies to the one action and the one actor it names. It does not transfer between actors or pool across actions."
    },
    {
      "id": "AT11-release-does-not-carry-to-next-evaluation",
      "given": {
        "environmentSupervision": 1,
        "previousEvaluation": {
          "supervisionIncrements": [
            {
              "raisedBy": "normative",
              "from": 1,
              "to": 3
            }
          ],
          "released": true
        },
        "nextEvaluation": {
          "environmentSupervision": 1,
          "normativeRailRaisesTo": 3
        }
      },
      "expect": {
        "nextEvaluationSupervision": 3,
        "priorReleaseApplied": false
      },
      "reason": "A release does not carry from one evaluation to the next. The next evaluation starts from the environment's level, and a new hold stands until it is released on its own."
    },
    {
