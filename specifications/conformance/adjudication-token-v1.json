    {
      "id": "AT13-importance-cannot-loosen-a-limit",
      "given": {
        "noNormResult": {
          "executionPermitted": false,
          "supervision": "silent_veto",
          "E_base": 80,
          "R": 0.25,
          "E_trust": 60,
          "A": 70
        },
        "importanceClaim": {
          "source": "operator",
          "urgency": 1.0,
          "requested": "apply the limit less strictly"
