    {
      "id": "AT06-release-own-increment-to-environment-level",
      "given": {
        "environmentSupervision": 1,
        "supervisionIncrements": [
          {
            "raisedBy": "normative",
            "from": 1,
            "to": 3
          }
        ],
        "currentSupervision": 3,
        "release": {
          "by": "normative",
          "signed": true,
          "actor": "agent:a",
          "action_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "to": 1
        }
      },
      "expect": {
        "supervision": 1,
        "releasePermitted": true
      },
      "reason": "The normative rail releases only the increment it raised, as a signed act, back to the level this specification derives from the environment and not below it."
    },
    {
      "id": "AT07-release-below-environment-level-refused",
      "given": {
        "environmentSupervision": 2,
        "supervisionIncrements": [
          {
            "raisedBy": "normative",
            "from": 2,
            "to": 3
          }
        ],
        "currentSupervision": 3,
        "release": {
          "by": "normative",
          "signed": true,
          "actor": "agent:a",
          "action_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "to": 1
        }
      },
      "expect": {
        "supervision": 2,
        "releasePermitted": false
      },
      "reason": "A release MUST NOT set supervision below the level the environment derives. The normative rail's own increment is released to 2; the request to 1 is refused."
    },
    {
      "id": "AT08-release-of-another-rail-increment-refused",
      "given": {
        "environmentSupervision": 1,
        "supervisionIncrements": [
          {
            "raisedBy": "prudence",
            "from": 1,
            "to": 2
          }
        ],
        "currentSupervision": 2,
        "release": {
          "by": "normative",
          "signed": true,
          "actor": "agent:a",
          "action_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "to": 1
        }
      },
      "expect": {
        "supervision": 2,
        "releasePermitted": false
      },
      "reason": "A rail MUST NOT release what another rail raised. The prudence rail set this increment; the normative rail's release leaves it in place."
    },
    {
      "id": "AT09-unsigned-release-refused",
      "given": {
        "environmentSupervision": 1,
        "supervisionIncrements": [
          {
            "raisedBy": "normative",
            "from": 1,
            "to": 3
          }
        ],
        "currentSupervision": 3,
        "release": {
          "by": "normative",
          "signed": false,
          "actor": "agent:a",
          "action_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "to": 1
        }
      },
      "expect": {
        "supervision": 3,
        "releasePermitted": false
      },
      "reason": "A release is an act signed by the party that raised the increment. An unsigned release is not a release."
    },
    {
      "id": "AT10-release-names-one-actor-and-one-action",
