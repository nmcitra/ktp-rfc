{
  "suite": "adjudication-token-v1",
  "kind": "normative-downstream-requirements",
  "specification": "KTP-CORE L11 (There are two SHOULD rails, and only one of them is this specification's) and schemas/adjudication-token.json",
  "note": "Normative downstream requirements for the carriage of norm content. This repository contains no Oracle, gateway or adjudicator runtime: these vectors fix decision requirements at the boundaries they name and do not define a formula for A, E or supervision. The reference for every vector is the no-norm result: what this specification produces for the same evaluation with no norm content applied, which an implementation computes or records before applying any. given/expect are test notation, not wire fields or new decision enums. All other applicable checks pass unless a vector states otherwise. Digests are shown as placeholders of the correct shape; time values are comparable trusted instants in seconds.",
  "supervision_notation": "supervision is written as an ordinal: a larger integer is more supervision, and silent_veto is the top. The notation stands for whatever ordered supervision outcomes an implementation's declared profile defines; it is not an enum this suite introduces. E_trust = E_base × (1 − R) is the Trust Score as published; A is the action's demand on the same scale.",
  "token_notation": "token objects carry the bound fields of schemas/adjudication-token.json. A token that is bound to a different action, actor, grant, evidence, zone or epoch than the evaluation's, or whose signature cannot be verified, or that has expired, is absent: tokenAbsent or tokenVoid in expect means the evaluation proceeds as if that token had never been presented.",
  "vectors": [
    {
      "id": "AT01-favorable-verdict-changes-nothing-measured",
      "given": {
        "noNormResult": {
          "executionPermitted": true,
          "supervision": 1,
          "E_base": 80,
          "R": 0.25,
          "E_trust": 60,
          "A": 40,
          "envelope": {
            "executableFraction": 1.0
          }
        },
        "gateDeclared": true,
        "token": {
          "favorable": true,
          "action_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "actor": "agent:a",
          "cnf_jkt": "jkt-a",
          "grant_digest": "sha256:4444444444444444444444444444444444444444444444444444444444444444",
          "evidence_digest": "sha256:6666666666666666666666666666666666666666666666666666666666666666",
          "zone_id": "zone-a",
          "topology_epoch": 5,
          "iat": 90,
          "exp": 110
        },
        "trustedNow": 100,
        "evaluationContext": {
          "actor": "agent:a",
          "action_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "grant_digest": "sha256:4444444444444444444444444444444444444444444444444444444444444444",
          "evidence_digest": "sha256:6666666666666666666666666666666666666666666666666666666666666666",
          "zone_id": "zone-a",
          "topology_epoch": 5
        }
      },
      "expect": {
        "gateSatisfied": true,
        "executionPermitted": true,
        "supervision": 1,
        "E_trust": 60,
        "A": 40,
        "envelope": {
          "executableFraction": 1.0
        }
      },
      "reason": "A favorable adjudication satisfies the gate it answers and nothing else. Capacity, demand, supervision and the envelope are exactly the no-norm result."
    },
    {
      "id": "AT02-unfavorable-verdict-restricts",
      "given": {
        "noNormResult": {
          "executionPermitted": true,
