          "envelope": {
            "executableFraction": 1.0
          }
        },
        "gateDeclared": true,
        "token": {
          "favorable": false,
          "action_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "actor": "agent:a",
          "cnf_jkt": "jkt-a",
          "grant_digest": "sha256:4444444444444444444444444444444444444444444444444444444444444444",
          "evidence_digest": "sha256:6666666666666666666666666666666666666666666666666666666666666666",
          "zone_id": "zone-a",
          "topology_epoch": 5,
          "iat": 90,
          "exp": 110
        },
        "trustedNow": 100
      },
      "expect": {
        "gateSatisfied": false,
        "executionPermitted": false,
        "E_trust": 60,
        "supervision": 1
      },
      "reason": "An unfavorable verdict leaves the gate unsatisfied and the action does not execute. The measured result is unchanged: the verdict is norm content, not measurement."
    },
    {
