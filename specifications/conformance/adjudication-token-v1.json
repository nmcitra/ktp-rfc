          "actor": "agent:a",
          "cnf_jkt": "jkt-a",
          "grant_digest": "sha256:4444444444444444444444444444444444444444444444444444444444444444",
          "evidence_digest": "sha256:6666666666666666666666666666666666666666666666666666666666666666",
          "zone_id": "zone-a",
