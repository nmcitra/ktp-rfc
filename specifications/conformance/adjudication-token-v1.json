      },
      "expect": {
        "executionPermitted": false,
        "supervision": "silent_veto",
        "E_trust": 60,
        "A": 70
      },
      "reason": "Importance MUST NOT be the reason an environmental limit is not applied, or applied less strictly. A 70 exceeds E_trust 60 and the veto stands, whoever asserts the urgency and however it is measured."
    },
    {
      "id": "AT14-aggregate-importance-changes-no-per-action-limit",
      "given": {
        "actions": [
          {
            "id": "x1",
            "A": 70,
            "E_trust": 60
          },
          {
            "id": "x2",
            "A": 70,
            "E_trust": 60
          },
          {
            "id": "x3",
            "A": 70,
            "E_trust": 60
          }
        ],
        "importanceClaim": {
          "scope": "the three together",
          "mission": "critical"
        }
      },
      "expect": {
        "perAction": [
          {
            "id": "x1",
            "executionPermitted": false
          },
          {
            "id": "x2",
            "executionPermitted": false
          },
          {
            "id": "x3",
            "executionPermitted": false
          }
        ]
      },
      "reason": "The importance of many actions together is a judgment about the many; it changes nothing about the limit that applies to each. Each action is evaluated against its own limit, and each is vetoed."
    },
