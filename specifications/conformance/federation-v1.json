            "ktp_version"
          ],
          "offers": [
            "trust_tier_thresholds"
          ]
        },
        "zone": "zone-b",
        "localTierThresholds": {
          "operator": 88
        }
      },
      "expect": {
        "conformant": true,
        "zoneThresholdsApplied": {
          "operator": 88
        }
      },
      "reason": "A federation MAY require coordination of formats and versions and MUST NOT require coordination of the inputs to a zone's evaluation; the zone's own thresholds apply."
    },
    {
