            "zone-a-to-zone-b": 0.7,
            "zone-b-to-zone-a": 0.5
          }
        },
        "confidentialWithheld": true
      },
      "reason": "The existence of the agreement and each direction's factor MUST be visible to the subjects of both zones; the remainder MAY be confidential under scoped disclosure."
    },
    {
      "id": "FD16-evaluation-input-coordination-not-required",
      "given": {
